# PostgreSQL connection string (Prisma datasource provider is "postgresql").
# Local example:  postgresql://user:password@localhost:5432/snappyforms?schema=public
# Hosted (Neon/Supabase/etc): use the provider's connection string. For serverless
# Postgres, append ?sslmode=require (and a pooled URL if your provider offers one).
DATABASE_URL="postgresql://user:password@localhost:5432/snappyforms?schema=public"

# Signs/authenticates session cookies. Generate your own with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Encrypts ParticipantCase.caseNumberEncrypted at rest (AES-256-GCM). Generate your
# own with: openssl rand -hex 32. Falls back to an insecure dev-only key if unset —
# never rely on that fallback outside a local sandbox.
CASE_DATA_ENCRYPTION_KEY="replace-with-a-random-64-char-hex-string"

# Enables the seeded demo-login buttons and the /dev/inbox notification panel.
# Turn this OFF in any environment that isn't a local/demo sandbox.
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"

# Base URL used to build QR payload links and magic-link URLs.
APP_BASE_URL="http://localhost:3000"

# Home-page sign-up emails (src/lib/signupNotify.ts). A Formspree form endpoint;
# the form's settings decide which inbox gets the email. Without it, a sign-up
# is only logged to the server console.
SIGNUP_FORMSPREE_URL=""
