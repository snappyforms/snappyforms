{
  "name": "snappyforms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate-on-build.mjs && next build",
    "migrate:on-build": "node scripts/migrate-on-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "smoke": "node smoke.mjs",
    "smoke:shift": "node shift-flow.mjs",
    "smoke:pa1895": "node pa1895-flow.mjs",
    "test:totp": "tsx tests/shiftTotp.test.ts",
    "test:middleware": "tsx tests/middleware.test.ts",
    "test": "npm run test:totp && npm run test:middleware && node smoke.mjs && node shift-flow.mjs && node pa1895-flow.mjs",
    "test:e2e": "docker compose up --build --exit-code-from pw-tests pw-tests",
    "test:e2e:stories": "docker compose up --build --exit-code-from demo-stories demo-stories",
    "test:e2e:shift": "docker compose up --build --exit-code-from shift-story shift-story",
    "test:e2e:maya": "docker compose up --build --exit-code-from maya-story maya-story",
    "tour:maya": "docker compose up --build --exit-code-from tour tour",
    "e2e:stories": "node e2e/demo-stories.mjs",
    "e2e:maya": "node e2e/maya-confirmation-story.mjs",
    "e2e:shift": "node e2e/shift-qr-story.mjs",
    "docker:up": "docker compose up --build webapp",
    "docker:down": "docker compose down -v"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "firebase": "^12.17.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.446.0",
    "nanoid": "^5.0.7",
    "next": "^14.2.35",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
